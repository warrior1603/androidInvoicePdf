<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Ring (Subtle Indigo) -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1A4338CA" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <!-- Middle Ring -->
    <item android:top="20dp" android:bottom="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#124338CA" />
        </shape>
    </item>
    <!-- Inner Ring -->
    <item android:top="40dp" android:bottom="40dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#0A4338CA" />
        </shape>
    </item>
    <!-- Crosshair Vertical -->
    <item android:left="59.5dp" android:right="59.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D4338CA" />
            <size android:width="1dp" />
        </shape>
    </item>
    <!-- Crosshair Horizontal -->
    <item android:top="59.5dp" android:bottom="59.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#0D4338CA" />
            <size android:height="1dp" />
        </shape>
    </item>
</layer-list>