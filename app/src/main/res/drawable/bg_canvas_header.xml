<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="400dp"
    android:height="140dp"
    android:viewportWidth="400"
    android:viewportHeight="140">

    <!-- Base Surface with Architectural Curve -->
    <path
        android:pathData="M0,0 H400 V120 C300,135 100,135 0,120 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:endColor="#FFFFFF"
                android:startColor="#F8FAFC" />
        </aapt:attr>
    </path>

    <!-- Enhanced Aurora Prism (Dual Glow) -->
    <!-- Primary Glow (Top Right) -->
    <path
        android:pathData="M200,0 Q400,0 400,120 V0 Z"
        android:alpha="0.1">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="400"
                android:centerY="0"
                android:gradientRadius="180"
                android:type="radial"
                android:startColor="?attr/colorPrimary"
                android:endColor="@android:color/transparent" />
        </aapt:attr>
    </path>
    <!-- Secondary Ghost Glow (Top Left - Prism effect) -->
    <path
        android:pathData="M0,0 H150 V100 Q0,100 0,0 Z"
        android:alpha="0.04">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="120"
                android:type="radial"
                android:startColor="#6366F1"
                android:endColor="@android:color/transparent" />
        </aapt:attr>
    </path>

    <!-- Refined Architectural Trace Lines -->
    <path
        android:strokeWidth="0.4"
        android:pathData="M-20,35 L420,15"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.12" />
    <path
        android:strokeWidth="0.4"
        android:pathData="M310,-10 L370,150"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.08" />
    <path
        android:strokeWidth="0.6"
        android:pathData="M-50,115 L450,118"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.04" />

    <!-- Structural Node with Focus Ring -->
    <!-- Outer Ghost Ring -->
    <path
        android:strokeWidth="0.5"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.1"
        android:pathData="M336,65 m-5,0 a5,5 0,1 1,10 0 a5,5 0,1 1,-10 0" />
    <!-- Inner Dot -->
    <path
        android:fillColor="?attr/colorPrimary"
        android:alpha="0.25"
        android:pathData="M336,65 m-2.2,0 a2.2,2.2 0,1 1,4.4 0 a2.2,2.2 0,1 1,-4.4 0" />

    <!-- Hairline Edge Definition (Subtle sharp border) -->
    <path
        android:strokeWidth="0.5"
        android:pathData="M400,120 C300,135 100,135 0,120"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.03" />

</vector>
