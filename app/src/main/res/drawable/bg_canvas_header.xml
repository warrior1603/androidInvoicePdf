<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="400dp"
    android:height="110dp"
    android:viewportWidth="400"
    android:viewportHeight="110">

    <!-- Minimalist Blueprint Surface (Very Light) -->
    <path
        android:pathData="M0,0 H400 V110 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:endColor="#FFFFFF"
                android:startColor="#F8FAFC" />
        </aapt:attr>
    </path>

    <!-- Discreet Technical Grid (Recalibrated for Slim) -->
    <path android:pathData="M0,35 H400 M0,70 H400 M0,105 H400"
        android:strokeWidth="0.3"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.04" />

    <path android:pathData="M40,0 V110 M80,0 V110 M120,0 V110 M160,0 V110 M200,0 V110 M240,0 V110 M280,0 V110 M320,0 V110 M360,0 V110"
        android:strokeWidth="0.3"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.04" />

    <!-- Ghost Technical Marks (Corner Viewfinders) -->
    <path android:pathData="M15,10 H25 M15,10 V20" android:strokeWidth="0.6" android:strokeColor="?attr/colorPrimary" android:alpha="0.08" />
    <path android:pathData="M385,10 H375 M385,10 V20" android:strokeWidth="0.6" android:strokeColor="?attr/colorPrimary" android:alpha="0.08" />

    <!-- The Active Node (Enhanced Technical Crosshair) -->
    <path
        android:strokeWidth="0.5"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.06"
        android:pathData="M350,55 m-10,0 a10,10 0,1 1,20 0 a10,10 0,1 1,-20 0" />

    <path
        android:strokeWidth="0.8"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.12"
        android:pathData="M343,55 A7,7 0 0,1 357,55" />

    <path
        android:fillColor="?attr/colorPrimary"
        android:alpha="0.25"
        android:pathData="M350,55 m-2,0 a2,2 0,1 1,4 0 a2,2 0,1 1,-4 0" />

    <path android:pathData="M338,55 H362 M350,43 V67" android:strokeWidth="0.3" android:strokeColor="?attr/colorPrimary" android:alpha="0.05" />

    <!-- Hairline Bottom Edge -->
    <path
        android:pathData="M0,109.5 H400"
        android:strokeWidth="0.5"
        android:strokeColor="?attr/colorPrimary"
        android:alpha="0.1" />

</vector>
