<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.chouchene.factures.fragments.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/documentsHubFragment"
        android:name="com.chouchene.factures.fragments.DocumentsHubFragment"
        android:label="@string/title_documents"
        tools:layout="@layout/fragment_documents_hub" />

    <fragment
        android:id="@+id/factureFragment"
        android:name="com.chouchene.factures.fragments.InvoiceGenrationFragment"
        android:label="@string/title_invoices"
        tools:layout="@layout/fragment_history_list" />

    <fragment
        android:id="@+id/bonCommandeFragment"
        android:name="com.chouchene.factures.fragments.BonDeCommandeFragment"
        android:label="@string/title_orders"
        tools:layout="@layout/fragment_history_list" />

    <fragment
        android:id="@+id/agendaFragment"
        android:name="com.chouchene.factures.fragments.AgendaFragment"
        android:label="@string/title_agenda"
        tools:layout="@layout/fragment_agenda" />

    <fragment
        android:id="@+id/clientsHubFragment"
        android:name="com.chouchene.factures.fragments.ClientsHubFragment"
        android:label="@string/title_clients"
        tools:layout="@layout/fragment_clients_hub" />

    <fragment
        android:id="@+id/parametresFragment"
        android:name="com.chouchene.factures.fragments.RapportsFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/activity_rapports" />

    <!-- Secondary navigation -->
    <fragment
        android:id="@+id/webViewPdfFragment"
        android:name="com.chouchene.factures.fragments.WebViewPdfFragment"
        android:label="PDF Preview"
        tools:layout="@layout/activity_webview_pdf_sendmail" />

    <fragment
        android:id="@+id/templatePreviewFragment"
        android:name="com.chouchene.factures.fragments.TemplatePreviewFragment"
        android:label="@string/pref_title_preview"
        tools:layout="@layout/fragment_template_preview" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.chouchene.factures.fragments.AboutFragment"
        android:label="@string/title_about"
        tools:layout="@layout/fragment_about" />

    <fragment
        android:id="@+id/helpFragment"
        android:name="com.chouchene.factures.fragments.HelpFragment"
        android:label="@string/title_help"
        tools:layout="@layout/fragment_help" />

    <fragment
        android:id="@+id/personalSettingsFragment"
        android:name="com.chouchene.factures.fragments.PersonalSettingsFragment"
        android:label="@string/pref_title_profile"
        tools:layout="@layout/activity_personal_settings" />

    <fragment
        android:id="@+id/clientDetailFragment"
        android:name="com.chouchene.factures.fragments.ClientDetailFragment"
        android:label="Détails Client"
        tools:layout="@layout/fragment_client_detail">
        <argument
            android:name="client_id"
            app:argType="integer" />
    </fragment>

    <activity
        android:id="@+id/settingsActivity"
        android:name="com.chouchene.factures.SettingsActivity"
        android:label="@string/title_settings" />

    <dialog
        android:id="@+id/addClientBottomSheet"
        android:name="com.chouchene.factures.fragments.AddClientBottomSheet"
        tools:layout="@layout/bottom_sheet_add_client" />

    <dialog
        android:id="@+id/createInvoiceBottomSheet"
        android:name="com.chouchene.factures.fragments.CreateInvoiceBottomSheet"
        tools:layout="@layout/bottom_sheet_create_invoice" />

    <dialog
        android:id="@+id/createBonBottomSheet"
        android:name="com.chouchene.factures.fragments.CreateBonBottomSheet"
        tools:layout="@layout/bottom_sheet_create_bon" />

    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.chouchene.factures.fragments.ExpensesFragment"
        android:label="@string/title_expenses"
        tools:layout="@layout/fragment_expenses_list" />

    <dialog
        android:id="@+id/addExpenseBottomSheet"
        android:name="com.chouchene.factures.fragments.AddExpenseBottomSheet"
        tools:layout="@layout/bottom_sheet_add_expense" />

    <fragment
        android:id="@+id/globalHistoryFragment"
        android:name="com.chouchene.factures.fragments.GlobalHistoryFragment"
        android:label="Journal d'activité"
        tools:layout="@layout/fragment_global_history" />

</navigation>
