<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".fragments.BonDeCommandeFragment"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_xxl">

        <TextView
            android:id="@+id/textView3"
            style="@style/App.FormSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="Informations bon de commande" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/App.CardView"
            android:layout_marginHorizontal="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm"
            app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/card_inner_padding"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_passager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/human_icon"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Passager"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_tel_passager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/baseline_local_phone_24"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Tel passager"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:helperText="JJ.MM.AAAA"
            app:startIconDrawable="@drawable/date_icon"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Date commande"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/edit_date_commande"
                android:focusable="false"
                android:clickable="true"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:helperText="HH:MM"
            app:startIconDrawable="@drawable/four_o_clock_icon"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Heure commande"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_heure_commande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:helperText="JJ.MM.AAAA"
            app:startIconDrawable="@drawable/date_icon"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Date prise en charge"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_date_prise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:helperText="HH:MM"
            app:startIconDrawable="@drawable/four_o_clock_icon"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Heure prise en charge"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_heure_prise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_pec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/location_pin_icon"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Lieu prise en charge"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/address_location_icon"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Destination"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_tarif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/pricing_icon"
            app:endIconMode="clear_text"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="Tarif"
            style="@style/App.TextInput">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
        <Button
            android:id="@+id/btn_save_info_bon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_marginTop="@dimen/space_md"
            android:layout_marginEnd="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_xxl"
            android:text="Generer bon de commande"
            style="@style/App.Button"/>


    </LinearLayout>
</ScrollView>