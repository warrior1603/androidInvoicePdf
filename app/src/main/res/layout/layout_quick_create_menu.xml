<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/colorSurface">

    <!-- Executive Vertical Accent -->
    <View
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_vertical_bar_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            style="@style/App.TextAppearance.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.3"
            android:letterSpacing="0.3"
            android:text="STUDIO DE CRÉATION" />

        <LinearLayout
            android:id="@+id/btn_create_invoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:src="@drawable/ic_typcn_document"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:orientation="vertical">
                <TextView
                    style="@style/App.TextAppearance.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Facture"
                    android:textSize="16sp" />
                <TextView
                    style="@style/App.TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.4"
                    android:text="Nouveau document fiscal" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_create_bon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="@color/icon_dashboard_bg"
                android:src="@drawable/ic_typcn_cart"
                app:tint="@color/icon_dashboard" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:orientation="vertical">
                <TextView
                    style="@style/App.TextAppearance.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bon de commande"
                    android:textSize="16sp" />
                <TextView
                    style="@style/App.TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.4"
                    android:text="Générer un bon de transport" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
