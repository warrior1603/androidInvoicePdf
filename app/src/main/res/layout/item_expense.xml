<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <View
                android:id="@+id/icon_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.04"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="@color/status_cancelled" />
            <ImageView
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:src="@drawable/ic_outline_cash"
                app:tint="@color/status_cancelled" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtDescription"
                style="@style/App.TextAppearance.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="16sp"
                android:letterSpacing="-0.01" />
            <TextView
                android:id="@+id/txtCategory"
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="CATEGORY"
                android:alpha="0.4"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />
            <TextView
                android:id="@+id/txtDate"
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="12/08/2024"
                android:alpha="0.3"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAmount"
            style="@style/App.TextAppearance.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- 0.00 €"
            android:textColor="#1E293B"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="80dp"
        android:background="?attr/colorOutline"
        android:alpha="0.06" />

</FrameLayout>
