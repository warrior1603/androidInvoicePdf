<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="18dp"
        android:paddingHorizontal="28dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="@drawable/bg_circle_soft"
            android:backgroundTint="@color/status_cancelled_bg"
            android:src="@drawable/ic_typcn_cart"
            app:tint="@color/status_cancelled" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/txtDescription"
                style="@style/App.TextAppearance.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="16sp"
                android:letterSpacing="-0.01" />
            <TextView
                android:id="@+id/txtCategory"
                style="@style/App.TextAppearance.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Catégorie"
                android:alpha="0.5" />
            <TextView
                android:id="@+id/txtDate"
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Date"
                android:alpha="0.3"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAmount"
            style="@style/App.TextAppearance.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- 0.00 €"
            android:textColor="@color/status_cancelled"
            android:textSize="16sp"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="92dp"
        android:background="?attr/colorOutline"
        android:alpha="0.06" />

</FrameLayout>
