<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    style="@style/App.CardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="18dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/bg_circle_soft"
            android:src="@drawable/ic_receipt_outline"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtClientName"
                style="@style/App.TextAppearance.TitleMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Client Name" />

            <TextView
                android:id="@+id/txtDate"
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="01/01/2024" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txtAmount"
                style="@style/App.TextAppearance.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100.00 €"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:minWidth="85dp"
                android:gravity="center"
                android:text="En attente"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_status_pending"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="none"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
