<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <!-- Executive Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_canvas_header"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp">

                <!-- Soft Underglow Aura -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_soft"
                    android:backgroundTint="?attr/colorPrimary"
                    android:alpha="0.08" />

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_typcn_calendar_outline"
                    app:tint="?attr/colorPrimary"
                    android:alpha="0.9" />

                <!-- Technical Precision Corner (Single) -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/colorPrimary"
                    android:alpha="0.2" />
                <View
                    android:layout_width="1dp"
                    android:layout_height="6dp"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/colorPrimary"
                    android:alpha="0.2" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/App.TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.25"
                    android:letterSpacing="0.1"
                    android:text="GESTION DU TEMPS" />

                <TextView
                    style="@style/App.TextAppearance.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="Agenda"
                    android:textSize="26sp"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/txt_agenda_briefing"
                    style="@style/App.TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.3"
                    android:letterSpacing="0.1"
                    android:text="SYNCHRONISATION DU PLANNING..."
                    android:textAllCaps="true"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Content Area with Vertical Accent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:layout_width="6dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="12dp"
                android:background="@drawable/bg_vertical_bar_history" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <!-- Sub Navigation / Tabs -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    style="@style/App.TabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    app:tabIndicatorHeight="2dp"
                    app:tabSelectedTextColor="@color/icon_agenda" />

                <!-- Date Ribbon (Timeline Rail) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDateRail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <!-- Filters (Minimal Chips) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginTop="16dp">
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/statusChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tout"
                            android:checked="true"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipScheduled"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="À venir"
                            app:chipIcon="@drawable/ic_status_clock"
                            app:chipIconTint="@color/status_pending"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCompleted"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terminées"
                            app:chipIcon="@drawable/ic_status_check"
                            app:chipIconTint="@color/status_paid"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCancelled"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Annulées"
                            app:chipIcon="@drawable/ic_status_x"
                            app:chipIconTint="@color/status_cancelled"
                            app:chipBackgroundColor="@android:color/transparent"
                            app:chipStrokeColor="?attr/colorOutline"
                            app:chipStrokeWidth="1dp" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_view_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <include layout="@layout/shimmer_history_item" />
                            <include layout="@layout/shimmer_history_item" />
                            <include layout="@layout/shimmer_history_item" />
                            <include layout="@layout/shimmer_history_item" />
                        </LinearLayout>
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBookings"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="88dp"
                        android:layoutAnimation="@anim/layout_animation_fall_down" />

                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingBottom="80dp">

                        <FrameLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp">
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0.05"
                                android:background="@drawable/bg_circle_soft"
                                android:backgroundTint="?attr/colorOnSurface" />
                            <ImageView
                                android:id="@+id/img_empty_state"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="32dp"
                                android:src="@drawable/ic_typcn_agenda"
                                android:alpha="0.2"
                                app:tint="?attr/colorOnSurface" />
                        </FrameLayout>

                        <TextView
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Aucune course prévue"
                            android:alpha="0.4"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddBooking"
        style="@style/Widget.Material3.ExtendedFloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Nouvelle Course"
        android:visibility="gone"
        app:icon="@drawable/rounded_add_24" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
