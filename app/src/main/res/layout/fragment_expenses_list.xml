<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include layout="@layout/shimmer_history_item" />
            <include layout="@layout/shimmer_history_item" />
            <include layout="@layout/shimmer_history_item" />
            <include layout="@layout/shimmer_history_item" />
            <include layout="@layout/shimmer_history_item" />
            <include layout="@layout/shimmer_history_item" />
            <include layout="@layout/shimmer_history_item" />
            <include layout="@layout/shimmer_history_item" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="88dp"
        android:layoutAnimation="@anim/layout_animation_fall_down" />

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/img_empty_state"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_typcn_document"
            android:alpha="0.2"
            app:tint="?attr/colorOutline"
            android:contentDescription="@null" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_empty_state"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:visibility="gone"
            android:saveEnabled="false"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:alpha="0.8" />

        <TextView
            style="@style/App.TextAppearance.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/empty_expenses"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            style="@style/App.TextAppearance.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/empty_expenses_sub"
            android:alpha="0.7" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab"
        style="@style/Widget.Material3.ExtendedFloatingActionButton.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/add_expense"
        app:icon="@drawable/rounded_add_24"
        android:contentDescription="@string/add_expense" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
