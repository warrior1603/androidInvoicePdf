<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Executive Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_canvas_header"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp">

            <!-- Soft Underglow Aura -->
            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="?attr/colorPrimary"
                android:alpha="0.08" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_typcn_chart_pie_outline"
                app:tint="?attr/colorPrimary"
                android:alpha="0.9" />

            <!-- Technical Precision Corner (Single) -->
            <View
                android:layout_width="6dp"
                android:layout_height="1dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                android:background="?attr/colorPrimary"
                android:alpha="0.2" />
            <View
                android:layout_width="1dp"
                android:layout_height="6dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                android:background="?attr/colorPrimary"
                android:alpha="0.2" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:letterSpacing="0.02"
                android:text="ANALYSE &amp; RAPPORTS" />

            <TextView
                style="@style/App.TextAppearance.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Dashboard"
                android:textSize="26sp"
                android:letterSpacing="-0.02" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="12dp"
            android:background="@drawable/bg_vertical_bar_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Compact Tab Selection (with its own padding for alignment) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/rapportsTabLayout"
                style="@style/App.TabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="12dp"
                android:background="@android:color/transparent"
                app:tabIndicatorHeight="2dp"
                app:tabSelectedTextColor="?attr/colorPrimary"
                app:tabTextAppearance="@style/App.TextAppearance.LabelSmall" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/rapportsViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>