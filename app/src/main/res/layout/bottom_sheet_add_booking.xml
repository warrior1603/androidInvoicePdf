<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/colorSurface">

    <!-- Executive Vertical Accent (Purple for Agenda) -->
    <View
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_vertical_bar_history" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.3"
                android:letterSpacing="0.02"
                android:text="STUDIO DE PLANIFICATION" />

            <TextView
                android:id="@+id/txt_title"
                style="@style/App.TextAppearance.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nouvelle Course"
                android:textSize="28sp"
                android:letterSpacing="-0.02" />

            <!-- Stepper Indicators (Minimal Bars) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:paddingHorizontal="40dp">
                <View
                    android:id="@+id/step_indicator_1"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vertical_bar_history" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />
                <View
                    android:id="@+id/step_indicator_2"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.3" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />
                <View
                    android:id="@+id/step_indicator_3"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.3" />
            </LinearLayout>
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/view_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp">

            <!-- Step 1: Client Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_name" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_phone" />
            </LinearLayout>

            <!-- Step 2: Trip Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_pickup" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_destination" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                </LinearLayout>

                <!-- Restored Map Preview (Flat Studio Style) -->
                <FrameLayout
                    android:id="@+id/layout_map_preview"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_section_flat"
                    android:backgroundTint="?attr/colorSurfaceVariant">
                    <android.webkit.WebView
                        android:id="@+id/webRoutePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.8" />
                    <View
                        android:id="@+id/mapTouchOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent" />
                </FrameLayout>
            </LinearLayout>

            <!-- Step 3: Pricing & Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_price" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchCancelled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:text="Course annulée"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/summary_text_booking"
                    style="@style/App.TextAppearance.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:alpha="0.5"
                    android:text="Vérifiez les informations avant d'enregistrer." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConvertToInvoice"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:text="Générer la facture"
                    android:visibility="gone"
                    app:icon="@drawable/ic_typcn_document" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:text="Supprimer la course"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:icon="@drawable/rounded_delete_24"
                    app:iconTint="?attr/colorError" />
            </LinearLayout>
        </ViewFlipper>

        <!-- Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_booking"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Retour"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_booking"
                style="@style/App.Button"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="Suivant"
                app:backgroundTint="@color/icon_agenda" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/App.Button"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="Enregistrer"
                android:visibility="gone"
                app:backgroundTint="@color/icon_agenda" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
