<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studio_success_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfetti_studio"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <FrameLayout
            android:id="@+id/success_icon_container"
            android:layout_width="160dp"
            android:layout_height="160dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="@color/status_paid"
                android:alpha="0.1" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_studio_success"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="32dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="false" />
        </FrameLayout>

        <TextView
            android:id="@+id/txt_studio_success_title"
            style="@style/App.TextAppearance.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Document Prêt !"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_studio_success_msg"
            style="@style/App.TextAppearance.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:gravity="center"
            android:text="Votre document a été généré et enregistré en toute sécurité." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_studio_view"
                style="@style/App.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VOIR LE DOCUMENT"
                app:icon="@drawable/ic_outline_eye"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_studio_share"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PARTAGER"
                app:icon="@drawable/rounded_share_24"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_studio_done"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="TERMINER"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
