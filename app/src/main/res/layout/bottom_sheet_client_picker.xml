<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="16dp"
    android:minHeight="500dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/App.TextAppearance.TitleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sélectionner un client"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
            style="@style/App.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rechercher un client..."
            app:startIconDrawable="@drawable/ic_search_outline"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvClients"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:layoutAnimation="@anim/layout_animation_fall_down" />

</LinearLayout>
