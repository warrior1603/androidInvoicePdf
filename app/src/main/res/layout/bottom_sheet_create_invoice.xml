<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/colorSurface">

    <!-- Executive Vertical Accent (Blue for Invoice) -->
    <View
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_vertical_bar_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.3"
                android:letterSpacing="0.02"
                android:text="STUDIO DE FACTURATION" />

            <TextView
                style="@style/App.TextAppearance.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nouvelle Facture"
                android:textSize="28sp"
                android:letterSpacing="-0.02" />

            <!-- Stepper Indicators (Minimal Bars) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:paddingHorizontal="40dp">
                <View
                    android:id="@+id/step_indicator_1"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vertical_bar_primary" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />
                <View
                    android:id="@+id/step_indicator_2"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.3" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />
                <View
                    android:id="@+id/step_indicator_3"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.3" />
            </LinearLayout>
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/view_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="350dp">

            <!-- Step 1: Client Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <RadioGroup
                    android:id="@+id/radio_group"
                    android:checkedButton="@+id/permanant_selected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="16dp">
                    <RadioButton
                        android:id="@+id/provisoire_selected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/label_guest"/>
                    <RadioButton
                        android:id="@+id/permanant_selected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/label_saved"/>
                </RadioGroup>

                <include layout="@layout/view_settings_dropdown_item" android:id="@+id/item_search_client" />

                <LinearLayout android:id="@+id/client_input_provisoire" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_name" />
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_street" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                        <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_zip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_city" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" />
                    </LinearLayout>
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_country" />
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_siren" />
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_tva" />
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_client_email" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 2: Invoice Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_date" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_description" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_qty" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_price" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_tva_rate" />
                <include layout="@layout/view_settings_dropdown_item" android:id="@+id/item_payment" />
            </LinearLayout>

            <!-- Step 3: Signature & Finish -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">
                <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="20dp" android:text="SIGNATURE (OPTIONNELLE)" android:alpha="0.3" android:letterSpacing="0.02" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginHorizontal="20dp" android:background="@drawable/bg_section_flat" android:backgroundTint="?attr/colorSurfaceVariant">
                    <com.chouchene.factures.utils.SignatureView android:id="@+id/signature_view" android:layout_width="match_parent" android:layout_height="match_parent" />
                </FrameLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_clear_signature" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginEnd="20dp" android:text="Effacer" android:textColor="?attr/colorError" />
                <TextView
                    android:id="@+id/summary_text"
                    style="@style/App.TextAppearance.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    android:alpha="0.5"
                    android:text="Vérifiez les informations avant de générer le PDF." />
            </LinearLayout>
        </ViewFlipper>

        <!-- Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Retour"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                style="@style/App.Button"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="Suivant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreatePdf"
                style="@style/App.Button"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="@string/action_generate_invoice"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
