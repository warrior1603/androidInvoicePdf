<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="48dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        style="@style/App.TextAppearance.TitleLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:text="@string/label_payment_status"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        style="@style/App.TextAppearance.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="4dp"
        android:text="@string/label_update_status"
        android:alpha="0.6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="20dp"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            android:id="@+id/status_pending"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="@string/status_pending"
            android:textAlignment="center"
            app:chipIcon="@drawable/ic_status_clock"
            app:chipIconTint="@color/white"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/bg_status_pending_selector"
            app:chipStrokeWidth="0dp"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/status_paid"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="@string/status_paid"
            android:textAlignment="center"
            app:chipIcon="@drawable/ic_status_check"
            app:chipIconTint="@color/white"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/bg_status_paid_selector"
            app:chipStrokeWidth="0dp"
            android:checkable="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/status_cancelled"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="@string/status_cancelled"
            android:textAlignment="center"
            app:chipIcon="@drawable/ic_status_x"
            app:chipIconTint="@color/white"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/bg_status_cancelled_selector"
            app:chipStrokeWidth="0dp"
            android:checkable="true" />

    </LinearLayout>

</LinearLayout>
