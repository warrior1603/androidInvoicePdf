<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_canvas_header"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp">

            <!-- Soft Underglow Aura -->
            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="?attr/colorPrimary"
                android:alpha="0.08" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_typcn_folder_open"
                app:tint="?attr/colorPrimary"
                android:alpha="0.9" />

            <!-- Technical Precision Corner (Single) -->
            <View
                android:layout_width="6dp"
                android:layout_height="1dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                android:background="?attr/colorPrimary"
                android:alpha="0.2" />
            <View
                android:layout_width="1dp"
                android:layout_height="6dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="6dp"
                android:layout_marginStart="6dp"
                android:background="?attr/colorPrimary"
                android:alpha="0.2" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:letterSpacing="0.02"
                android:text="CENTRE DE GESTION" />

            <TextView
                style="@style/App.TextAppearance.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Documents"
                android:textSize="26sp"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/txt_documents_briefing"
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.3"
                android:letterSpacing="0.05"
                android:text="CHARGEMENT DU REGISTRE..."
                android:textAllCaps="true"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Area with Vertical Accent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="12dp"
            android:background="@drawable/bg_vertical_bar_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                style="@style/App.TabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                app:tabIndicatorHeight="2dp"
                app:tabSelectedTextColor="?attr/colorPrimary" />

            <!-- Status Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/statusChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tous"
                        android:checked="true"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipStrokeColor="?attr/colorOutline"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPaid"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Payée"
                        app:chipIcon="@drawable/ic_status_check"
                        app:chipIconTint="@color/status_paid"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipStrokeColor="?attr/colorOutline"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPending"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attente"
                        app:chipIcon="@drawable/ic_status_clock"
                        app:chipIconTint="@color/status_pending"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipStrokeColor="?attr/colorOutline"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCancelled"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Annulée"
                        app:chipIcon="@drawable/ic_status_x"
                        app:chipIconTint="@color/status_cancelled"
                        app:chipBackgroundColor="@android:color/transparent"
                        app:chipStrokeColor="?attr/colorOutline"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.chip.Chip
                android:id="@+id/filterChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:chipIcon="@drawable/ic_outline_adjustments"
                app:chipIconTint="?attr/colorPrimary"
                app:closeIconVisible="true"
                android:text="Filtré par: Juin 2024" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>