<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/container_invoice_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <include layout="@layout/view_settings_input_item" android:id="@+id/item_inv_date" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="56dp" android:alpha="0.1" />

        <include layout="@layout/view_settings_input_item" android:id="@+id/item_inv_desc" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="56dp" android:alpha="0.1" />

        <include layout="@layout/view_settings_dropdown_item" android:id="@+id/item_inv_payment" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:id="@+id/container_bon_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
            <include layout="@layout/view_settings_input_item" android:id="@+id/item_bon_pickup_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/view_settings_input_item" android:id="@+id/item_bon_pickup_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        </LinearLayout>
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="56dp" android:alpha="0.1" />

        <include layout="@layout/view_settings_input_item" android:id="@+id/item_bon_pec" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="56dp" android:alpha="0.1" />

        <include layout="@layout/view_settings_input_item" android:id="@+id/item_bon_dest" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
