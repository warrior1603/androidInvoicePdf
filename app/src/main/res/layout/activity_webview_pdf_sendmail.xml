<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Section 1: Pure Flat Header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_pdf"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                app:icon="@drawable/ic_typcn_chevron_right"
                android:rotation="180"
                app:iconTint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/txt_preview_title"
                    style="@style/App.TextAppearance.TitleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_preview_doc"
                    android:textSize="22sp"
                    android:letterSpacing="-0.02" />
                <TextView
                    android:id="@+id/txt_preview_subtitle"
                    style="@style/App.TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.3"
                    android:text="REVUE DE DOCUMENT" />
            </LinearLayout>

            <ImageView
                android:id="@+id/img_header_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_typcn_document"
                app:tint="?attr/colorPrimary"
                android:alpha="0.4" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- PDF Viewer Area (Canvas Style) -->
        <com.github.barteksc.pdfviewer.PDFView
            android:id="@+id/pdfView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceVariant"
            android:padding="8dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- Zoom Indicator (Flat Overlay) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_zoom_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#CC000000"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <TextView
                android:id="@+id/txt_zoom_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="100%"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Loading Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_loading_pdf"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Enhanced Floating Dock Action Bar -->
        <LinearLayout
            android:id="@+id/card_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_section_flat"
            android:backgroundTint="?attr/colorSurface"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:elevation="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <!-- Send Email -->
            <LinearLayout
                android:id="@+id/btn_email_container"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:id="@+id/emailButtonIcon"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_typcn_mail"
                    app:tint="?attr/colorPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAIL"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:alpha="0.4"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <!-- Share -->
            <LinearLayout
                android:id="@+id/btn_share_container"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_typcn_export_outline"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PARTAGER"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:alpha="0.4"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <!-- Print -->
            <LinearLayout
                android:id="@+id/btn_print_container"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_typcn_printer"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMPRIMER"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:alpha="0.4"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <!-- Edit -->
            <LinearLayout
                android:id="@+id/btn_edit_container"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_typcn_pen"
                    app:tint="?attr/colorOnSurfaceVariant" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EDITER"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:alpha="0.4"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Legacy compatibility views (hidden) -->
    <com.google.android.material.button.MaterialButton android:id="@+id/emailButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />
    <com.google.android.material.button.MaterialButton android:id="@+id/shareButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />
    <com.google.android.material.button.MaterialButton android:id="@+id/printButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />
    <com.google.android.material.button.MaterialButton android:id="@+id/editButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints" />
    <View android:id="@+id/buttonsPdf" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" tools:ignore="MissingConstraints"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>