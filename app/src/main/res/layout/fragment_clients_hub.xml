<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Executive Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_canvas_header"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp">

            <!-- Soft Underglow Aura -->
            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="?attr/colorPrimary"
                android:alpha="0.08" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_typcn_group_outline"
                app:tint="?attr/colorPrimary"
                android:alpha="0.9" />

            <!-- Technical Precision Corner (Single) -->
            <View
                android:layout_width="8dp"
                android:layout_height="1dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:background="?attr/colorPrimary"
                android:alpha="0.2" />
            <View
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:background="?attr/colorPrimary"
                android:alpha="0.2" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.5"
                android:letterSpacing="0.02"
                android:text="CARNET D'ADRESSES" />

            <TextView
                style="@style/App.TextAppearance.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Clients"
                android:textSize="30sp"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/txt_clients_briefing"
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.3"
                android:letterSpacing="0.05"
                android:text="SYNCHRONISATION DU CARNET..."
                android:textAllCaps="true"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Area with Vertical Accent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="12dp"
            android:background="@drawable/bg_vertical_bar_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/clientsTabLayout"
                style="@style/App.TabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                app:tabIndicatorHeight="2dp"
                app:tabSelectedTextColor="@color/status_paid" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/clientsViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>