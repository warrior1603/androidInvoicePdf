<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:shimmer_auto_start="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <View android:layout_width="match_parent" android:layout_height="120dp" android:background="@drawable/shimmer_rect" android:layout_marginBottom="16dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:background="@drawable/shimmer_rect"/>
                <View android:layout_width="16dp" android:layout_height="1dp"/>
                <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:background="@drawable/shimmer_rect"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="16dp" android:background="@drawable/shimmer_rect"/>
            <View android:layout_width="150dp" android:layout_height="24dp" android:layout_marginTop="32dp" android:background="@drawable/shimmer_rect"/>
            <View android:layout_width="match_parent" android:layout_height="250dp" android:layout_marginTop="12dp" android:background="@drawable/shimmer_rect"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Main Revenue Card (Elite Compact Style) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/App.CardView"
            android:layout_margin="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/revenue_gradient">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="24dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/revenueLabel"
                            style="@style/App.TextAppearance.LabelLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RÉSUMÉ DES REVENUS"
                            android:textColor="@android:color/white"
                            android:alpha="0.7"
                            android:letterSpacing="0.1"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/totalRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0.00 €"
                            android:textColor="@android:color/white"
                            android:textSize="32sp"
                            android:fontFamily="sans-serif-black"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_margin"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:indicatorColor="@android:color/white"
                            app:trackColor="#40FFFFFF"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="6dp"
                            android:progress="70" />

                        <TextView
                            android:id="@+id/txt_margin_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Marge réelle: 70%"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:alpha="0.8"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="#20FFFFFF"
                        app:strokeWidth="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp"
                            android:src="@drawable/ic_wallet_outline"
                            app:tint="@android:color/white" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- Document Count Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.CardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_receipt_outline"
                        app:tint="@color/icon_documents" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/documentCount"
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Documents"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:alpha="0.6" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Total Clients Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.CardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_nav_user_outline"
                        app:tint="@color/icon_clients" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/txt_total_clients_val"
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clients"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:alpha="0.6" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Row 2: Growth & Expenses -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- Growth Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.CardView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_trending_up_outline"
                    app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:id="@+id/txt_growth_val"
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0%"
                            android:textStyle="bold"
                            android:textColor="@color/status_paid" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Croissance"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:alpha="0.6" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Expenses Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExpenses"
                style="@style/App.CardView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_wallet_outline"
                        app:tint="@color/icon_expenses" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1">
                        <TextView
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dépenses"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Gérer"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/icon_expenses"
                            android:textStyle="bold"
                            android:alpha="0.9" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/rounded_chevron_right_24"
                        app:tint="?attr/colorOutlineVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Analysis Section -->
        <TextView
            android:id="@+id/chartTitle"
            style="@style/App.TextAppearance.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="TENDANCE DU BÉNÉFICE"
            android:textColor="?attr/colorPrimary"
            android:letterSpacing="0.05"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            style="@style/App.CardView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/chart_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingBottom="40dp">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/graph_svgrepo_com"
                        app:tint="?attr/colorOutline"
                        android:alpha="0.15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Aucune donnée à analyser"
                        android:alpha="0.4"
                        android:textStyle="bold"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
