<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:shimmer_auto_start="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <View android:layout_width="match_parent" android:layout_height="120dp" android:background="@drawable/shimmer_rect" android:layout_marginBottom="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="80dp" android:background="@drawable/shimmer_rect" android:layout_marginBottom="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="200dp" android:background="@drawable/shimmer_rect"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="120dp">

            <!-- Summary Section with Executive Glow (Full Bleed) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_financial_pulse_gradient"
                android:paddingHorizontal="12dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/revenueLabel"
                    style="@style/App.TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.4"
                    android:letterSpacing="0.2"
                    android:text="RÉSULTAT NET"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/totalRevenue"
                    style="@style/App.TextAppearance.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0.00 €"
                    android:textSize="48sp"
                    android:letterSpacing="-0.04"
                    android:textColor="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_pill_soft"
                    android:backgroundTint="#0D4CAF50"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/txt_growth_val"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0%"
                        android:textColor="@color/status_paid"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:alpha="0.5"
                        android:textSize="10sp"
                        android:text="vs période préc." />
                </LinearLayout>
            </LinearLayout>

            <!-- Chart Section (Line Style) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="32dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/chart_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUCUNE DONNÉE"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:alpha="0.3" />
                </LinearLayout>
            </FrameLayout>

            <!-- Bento Metrics Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Marge Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:padding="16dp"
                        android:background="@drawable/bg_section_flat"
                        android:backgroundTint="#054F46E5"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.4"
                            android:text="MARGE" />

                        <TextView
                            android:id="@+id/txt_margin_label"
                            style="@style/App.TextAppearance.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0%" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_margin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:trackThickness="2dp"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackColor="?attr/colorSurfaceVariant"
                            android:progress="0" />
                    </LinearLayout>

                    <!-- Volume Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:padding="16dp"
                        android:background="@drawable/bg_section_flat"
                        android:backgroundTint="#05000000"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.4"
                            android:text="DOCUMENTS" />

                        <TextView
                            android:id="@+id/documentCount"
                            style="@style/App.TextAppearance.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0" />
                    </LinearLayout>

                    <!-- Clients Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:padding="16dp"
                        android:background="@drawable/bg_section_flat"
                        android:backgroundTint="#054CAF50"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.4"
                            android:text="CLIENTS" />

                        <TextView
                            android:id="@+id/txt_total_clients_val"
                            style="@style/App.TextAppearance.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Actions & Shortcuts -->
                <LinearLayout
                    android:id="@+id/cardExpenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:background="@drawable/bg_section_flat"
                    android:backgroundTint="#05F44336"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_outline_cash"
                        app:tint="@color/status_cancelled"
                        android:alpha="0.6" />

                    <TextView
                        style="@style/App.TextAppearance.TitleMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Gérer les dépenses"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_typcn_chevron_right"
                        app:tint="?attr/colorOutline"
                        android:alpha="0.3" />
                </LinearLayout>

                <!-- Bottom Export Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportCsv"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Exporter CSV"
                        app:icon="@drawable/ic_typcn_export_outline"
                        app:iconSize="16dp" />

                    <View android:layout_width="24dp" android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateReportPdf"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bilan PDF"
                        app:icon="@drawable/ic_pdf_outline"
                        app:iconSize="16dp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
