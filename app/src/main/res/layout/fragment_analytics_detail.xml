<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:shimmer_auto_start="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <View android:layout_width="match_parent" android:layout_height="120dp" android:background="@drawable/shimmer_rect" android:layout_marginBottom="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="80dp" android:background="@drawable/shimmer_rect" android:layout_marginBottom="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="200dp" android:background="@drawable/shimmer_rect"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="120dp">

            <!-- Summary Section (Pure & Clean) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp"
                android:baselineAligned="false">

                <!-- Left: Financial Result -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_dashboard_briefing"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.25"
                        android:letterSpacing="0.1"
                        android:text="ANALYSE DE PERFORMANCE"
                        android:textAllCaps="true"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/revenueLabel"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:alpha="0.4"
                        android:letterSpacing="0.2"
                        android:text="RÉSULTAT NET"
                        android:textAllCaps="true"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/totalRevenue"
                        style="@style/App.TextAppearance.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0.00 €"
                        android:textSize="36sp"
                        android:fontFamily="sans-serif-thin"
                        android:letterSpacing="-0.04"
                        android:textColor="#1E293B" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pill_soft"
                        android:backgroundTint="#0D4CAF50"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <TextView
                            android:id="@+id/txt_growth_val"
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0%"
                            android:textSize="10sp"
                            android:textColor="@color/status_paid"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:alpha="0.5"
                            android:textSize="9sp"
                            android:text="vs préc." />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right: Quick Actions -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cardExpenses"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dépenses"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_outline_cash"
                        app:iconSize="14dp"
                        app:iconPadding="4dp"
                        app:cornerRadius="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportCsv"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_typcn_export_outline"
                            app:iconTint="?attr/colorPrimary"
                            app:iconSize="18dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGenerateReportPdf"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_pdf_outline"
                            app:iconTint="?attr/colorPrimary"
                            app:iconSize="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:alpha="0.06" />

            <!-- Chart Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="12dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/chart_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUCUNE DONNÉE"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:alpha="0.3" />
                </LinearLayout>
            </FrameLayout>

            <!-- Bento Metrics Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Marge Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:padding="16dp"
                        android:background="@drawable/bg_section_flat"
                        android:backgroundTint="#0A4F46E5"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_typcn_chart_line"
                            app:tint="?attr/colorPrimary"
                            android:alpha="0.6"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.4"
                            android:text="MARGE" />

                        <TextView
                            android:id="@+id/txt_margin_label"
                            style="@style/App.TextAppearance.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0%" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_margin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:trackThickness="2dp"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackColor="?attr/colorSurfaceVariant"
                            android:progress="0" />
                    </LinearLayout>

                    <!-- Volume Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:padding="16dp"
                        android:background="@drawable/bg_section_flat"
                        android:backgroundTint="#0A000000"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_typcn_document"
                            app:tint="?attr/colorOnSurface"
                            android:alpha="0.6"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.4"
                            android:text="VOLUME" />

                        <TextView
                            android:id="@+id/documentCount"
                            style="@style/App.TextAppearance.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0" />

                        <TextView
                            android:id="@+id/txt_doc_count_trend"
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.3"
                            android:textSize="9sp"
                            android:text="N/A" />
                    </LinearLayout>

                    <!-- Clients Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:padding="16dp"
                        android:background="@drawable/bg_section_flat"
                        android:backgroundTint="#0A4CAF50"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_typcn_group_outline"
                            app:tint="@color/status_paid"
                            android:alpha="0.6"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.4"
                            android:text="CLIENTS" />

                        <TextView
                            android:id="@+id/txt_total_clients_val"
                            style="@style/App.TextAppearance.TitleLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0" />

                        <TextView
                            android:id="@+id/txt_client_count_trend"
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.3"
                            android:textSize="9sp"
                            android:text="N/A" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Space for Bottom padding -->
                <View android:layout_width="match_parent" android:layout_height="48dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
