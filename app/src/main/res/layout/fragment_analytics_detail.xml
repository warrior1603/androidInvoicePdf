<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:shimmer_auto_start="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <View android:layout_width="match_parent" android:layout_height="120dp" android:background="@drawable/shimmer_rect" android:layout_marginBottom="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="80dp" android:background="@drawable/shimmer_rect" android:layout_marginBottom="16dp"/>
            <View android:layout_width="match_parent" android:layout_height="200dp" android:background="@drawable/shimmer_rect"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="120dp">

            <!-- Summary Section (Full Width Hierarchy) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- Performance Briefing -->
                <TextView
                    android:id="@+id/txt_dashboard_briefing"
                    style="@style/App.TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.3"
                    android:letterSpacing="0.1"
                    android:text="ANALYSE DE PERFORMANCE"
                    android:textAllCaps="true"
                    android:textSize="9sp" />

                <!-- Main Revenue Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/revenueLabel"
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.4"
                            android:letterSpacing="0.2"
                            android:text="RÉSULTAT NET"
                            android:textAllCaps="true"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/totalRevenue"
                            style="@style/App.TextAppearance.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0.00 €"
                            android:textSize="40sp"
                            android:letterSpacing="-0.04"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pill_soft"
                        android:backgroundTint="#0D4CAF50"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/txt_growth_val"
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+0%"
                            android:textSize="11sp"
                            android:textColor="@color/status_paid"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:alpha="0.5"
                            android:textSize="9sp"
                            android:text="vs préc." />
                    </LinearLayout>
                </LinearLayout>

                <!-- Technical Utility Rail (Actions) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cardExpenses"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.2"
                        android:text="Dépenses"
                        android:textSize="11sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_outline_cash"
                        app:iconSize="14dp"
                        app:iconPadding="6dp"
                        app:cornerRadius="12dp"
                        android:textColor="@color/status_cancelled"
                        app:iconTint="@color/status_cancelled"
                        app:backgroundTint="#12BE123C"
                        app:elevation="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExportCsv"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="0.9"
                        android:layout_marginStart="8dp"
                        android:text="CSV"
                        android:textSize="11sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_typcn_export_outline"
                        app:iconSize="16dp"
                        app:iconPadding="6dp"
                        app:cornerRadius="12dp"
                        app:iconTint="?attr/colorOnSurfaceVariant"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:backgroundTint="#08000000" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateReportPdf"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="0.9"
                        android:layout_marginStart="8dp"
                        android:text="PDF"
                        android:textSize="11sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_pdf_outline"
                        app:iconSize="16dp"
                        app:iconPadding="6dp"
                        app:cornerRadius="12dp"
                        app:iconTint="?attr/colorOnSurfaceVariant"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        app:backgroundTint="#08000000" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="28dp"
                android:alpha="0.06" />

            <!-- Chart Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="12dp">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/lineChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/chart_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AUCUNE DONNÉE"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:alpha="0.3" />
                </LinearLayout>
            </FrameLayout>

            <!-- Precision Goals Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.25"
                        android:letterSpacing="0.1"
                        android:text="OBJECTIFS DE PRÉCISION [TRG_MONTH]"
                        android:textSize="9sp" />
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_typcn_chart_line"
                        app:tint="?attr/colorPrimary"
                        android:alpha="0.2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txt_goal_current"
                        style="@style/App.TextAppearance.NumberBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 €"
                        android:textSize="20sp" />
                    <TextView
                        android:id="@+id/txt_goal_target"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:alpha="0.3"
                        android:text="/ 5000 €" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="2dp"
                        android:alpha="0.1">
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutline" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <View android:layout_width="1dp" android:layout_height="4dp" android:layout_gravity="center_vertical" android:background="?attr/colorOutline" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <View android:layout_width="1dp" android:layout_height="6dp" android:background="?attr/colorOutline" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <View android:layout_width="1dp" android:layout_height="4dp" android:layout_gravity="center_vertical" android:background="?attr/colorOutline" />
                        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/colorOutline" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_revenue_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:trackThickness="1.5dp"
                        app:trackColor="?attr/colorOutline"
                        app:indicatorColor="?attr/colorPrimary"
                        android:progress="30" />
                </FrameLayout>
            </LinearLayout>

            <!-- Bento Metrics Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Marge Card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp">

                        <View android:layout_width="8dp" android:layout_height="1dp" android:layout_gravity="top|start" android:layout_marginTop="8dp" android:layout_marginStart="8dp" android:background="?attr/colorPrimary" android:alpha="0.2" />
                        <View android:layout_width="1dp" android:layout_height="8dp" android:layout_gravity="top|start" android:layout_marginTop="8dp" android:layout_marginStart="8dp" android:background="?attr/colorPrimary" android:alpha="0.2" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:background="@drawable/bg_section_flat"
                            android:backgroundTint="#0A4F46E5"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_typcn_chart_line"
                                app:tint="?attr/colorPrimary"
                                android:alpha="0.6"
                                android:layout_marginBottom="8dp"/>

                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.4"
                                android:text="MARGE" />

                            <TextView
                                android:id="@+id/txt_margin_label"
                                style="@style/App.TextAppearance.NumberBig"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0%"
                                android:textSize="20sp" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/progress_margin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                app:trackThickness="2dp"
                                app:indicatorColor="?attr/colorPrimary"
                                app:trackColor="?attr/colorSurfaceVariant"
                                android:progress="0" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Volume Card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp">

                        <View android:layout_width="8dp" android:layout_height="1dp" android:layout_gravity="top|start" android:layout_marginTop="8dp" android:layout_marginStart="8dp" android:background="?attr/colorOnSurface" android:alpha="0.1" />
                        <View android:layout_width="1dp" android:layout_height="8dp" android:layout_gravity="top|start" android:layout_marginTop="8dp" android:layout_marginStart="8dp" android:background="?attr/colorOnSurface" android:alpha="0.1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:background="@drawable/bg_section_flat"
                            android:backgroundTint="#0A000000"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_typcn_document"
                                app:tint="?attr/colorOnSurface"
                                android:alpha="0.6"
                                android:layout_marginBottom="8dp"/>

                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.4"
                                android:text="VOLUME" />

                            <TextView
                                android:id="@+id/documentCount"
                                style="@style/App.TextAppearance.NumberBig"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/txt_doc_count_trend"
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.3"
                                android:textSize="9sp"
                                android:text="N/A" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Clients Card -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp">

                        <View android:layout_width="8dp" android:layout_height="1dp" android:layout_gravity="top|start" android:layout_marginTop="8dp" android:layout_marginStart="8dp" android:background="@color/status_paid" android:alpha="0.2" />
                        <View android:layout_width="1dp" android:layout_height="8dp" android:layout_gravity="top|start" android:layout_marginTop="8dp" android:layout_marginStart="8dp" android:background="@color/status_paid" android:alpha="0.2" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:background="@drawable/bg_section_flat"
                            android:backgroundTint="#0A4CAF50"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_typcn_group_outline"
                                app:tint="@color/status_paid"
                                android:alpha="0.6"
                                android:layout_marginBottom="8dp"/>

                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.4"
                                android:text="CLIENTS" />

                            <TextView
                                android:id="@+id/txt_total_clients_val"
                                style="@style/App.TextAppearance.NumberBig"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/txt_client_count_trend"
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.3"
                                android:textSize="9sp"
                                android:text="N/A" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- Space for Bottom padding -->
                <View android:layout_width="match_parent" android:layout_height="48dp" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
