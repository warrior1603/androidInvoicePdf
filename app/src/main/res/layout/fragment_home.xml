<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- "The Canvas" Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_canvas_header"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/txt_greeting"
                    style="@style/App.TextAppearance.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_welcome_back" />

                <TextView
                    android:id="@+id/txt_current_date"
                    style="@style/App.TextAppearance.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Date du jour" />

                <FrameLayout
                    android:id="@+id/card_monthly_insights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <!-- Ambient Horizon Sparkline -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom"
                        android:alpha="0.1"
                        android:scaleType="centerCrop"
                        android:src="@drawable/revenue_sparkline"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="BÉNÉFICE DU MOIS"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/txt_home_revenue"
                            style="@style/App.TextAppearance.NumberBig"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00 €"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="44sp" />

                        <TextView
                            android:id="@+id/txt_home_revenue_daily"
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Aujourd'hui: 0.00 €" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Metrics Floating Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_section_flat"
                android:backgroundTint="?attr/colorSurface"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:outlineProvider="background">

                <LinearLayout
                    android:id="@+id/stat_invoices"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_home_invoice_count"
                        style="@style/App.TextAppearance.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.5"
                        android:text="Factures"
                        android:textAllCaps="true"
                        android:textSize="9sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:alpha="0.1"
                    android:background="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/stat_orders"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_home_bon_count"
                        style="@style/App.TextAppearance.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.5"
                        android:text="Devis"
                        android:textAllCaps="true"
                        android:textSize="9sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:alpha="0.1"
                    android:background="?attr/colorOnSurface" />

                <LinearLayout
                    android:id="@+id/stat_bookings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_home_booking_count"
                        style="@style/App.TextAppearance.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.5"
                        android:text="Courses"
                        android:textAllCaps="true"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <!-- Next Upcoming Trip Section (Soft Badge) -->
                <LinearLayout
                    android:id="@+id/card_next_trip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pill_soft"
                    android:backgroundTint="@color/icon_agenda_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/rounded_calendar_today_24"
                        app:tint="@color/icon_agenda" />

                    <TextView
                        android:id="@+id/txt_next_trip_time"
                        style="@style/App.TextAppearance.LabelLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="14:30"
                        android:textColor="@color/icon_agenda"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_next_trip_route"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:alpha="0.7"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Lieu de prise en charge"
                        android:textColor="@color/icon_agenda" />

                    <ImageView
                        android:id="@+id/btn_view_trip"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:alpha="0.5"
                        android:src="@drawable/ic_typcn_chevron_right"
                        app:tint="@color/icon_agenda" />
                </LinearLayout>

                <!-- Payment Alert Section (Soft Badge) -->
                <LinearLayout
                    android:id="@+id/card_overdue_alert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_pill_soft"
                    android:backgroundTint="@color/status_cancelled_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/rounded_info_24"
                        app:tint="@color/status_cancelled" />

                    <TextView
                        android:id="@+id/txt_overdue_count"
                        style="@style/App.TextAppearance.LabelLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/label_overdue_alert"
                        android:textColor="@color/status_cancelled"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:alpha="0.5"
                        android:src="@drawable/ic_typcn_chevron_right"
                        app:tint="@color/status_cancelled" />
                </LinearLayout>

                <!-- Shortcuts Section -->
                <TextView
                    style="@style/App.TextAppearance.TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Raccourcis" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alignmentMode="alignMargins"
                    android:columnCount="3">

                    <!-- Documents -->
                    <LinearLayout
                        android:id="@+id/card_documents"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0.15"
                                android:background="@drawable/bg_circle_soft"
                                android:backgroundTint="@color/icon_documents_bg" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_typcn_document"
                                app:tint="@color/icon_documents" />

                            <View
                                android:id="@+id/badge_overdue"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="top|end"
                                android:layout_marginTop="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_status_cancelled"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Documents"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Clients -->
                    <LinearLayout
                        android:id="@+id/card_clients"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0.15"
                                android:background="@drawable/bg_circle_soft"
                                android:backgroundTint="@color/icon_clients_bg" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_typcn_group_outline"
                                app:tint="@color/icon_clients" />
                        </FrameLayout>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Clients"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Agenda -->
                    <LinearLayout
                        android:id="@+id/card_agenda"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0.15"
                                android:background="@drawable/bg_circle_soft"
                                android:backgroundTint="@color/icon_agenda_bg" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_typcn_calendar_outline"
                                app:tint="@color/icon_agenda" />
                        </FrameLayout>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/title_agenda"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Dashboard -->
                    <LinearLayout
                        android:id="@+id/card_dashboard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0.15"
                                android:background="@drawable/bg_circle_soft"
                                android:backgroundTint="@color/icon_dashboard_bg" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_typcn_chart_pie_outline"
                                app:tint="@color/icon_dashboard" />
                        </FrameLayout>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Dashboard"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Entreprise -->
                    <LinearLayout
                        android:id="@+id/card_profile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0.15"
                                android:background="@drawable/bg_circle_soft"
                                android:backgroundTint="@color/icon_profile_bg" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_typcn_entreprise"
                                app:tint="@color/icon_profile" />
                        </FrameLayout>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Entreprise"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Settings -->
                    <LinearLayout
                        android:id="@+id/card_settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="12dp">

                        <FrameLayout
                            android:layout_width="72dp"
                            android:layout_height="72dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:alpha="0.15"
                                android:background="@drawable/bg_circle_soft"
                                android:backgroundTint="@color/icon_settings_bg" />

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_typcn_spanner_outline"
                                app:tint="@color/icon_settings" />
                        </FrameLayout>

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/title_settings"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                </GridLayout>

                <!-- Recent Activity Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/App.TextAppearance.TitleLarge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Activité Récente" />

                    <TextView
                        android:id="@+id/btn_view_all_recent"
                        style="@style/App.TextAppearance.LabelLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Voir tout"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:shimmer_auto_start="true">

                    <include layout="@layout/shimmer_home_recent" />
                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_home_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="32dp"
                    android:clipToPadding="false"
                    android:layoutAnimation="@anim/layout_animation_fall_down"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>