<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/App.TextAppearance.TitleLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_welcome_back"
            android:textSize="28sp" />

        <TextView
            style="@style/App.TextAppearance.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/label_quick_access"
            android:alpha="0.7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Documents Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_documents"
                    style="@style/App.CardView"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="12dp"
                            android:src="@drawable/baseline_description_24"
                            android:backgroundTint="?attr/colorPrimaryContainer"
                            android:background="@drawable/profile_background"
                            app:shapeAppearanceOverlay="@style/App.ShapeAppearance.Circle"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/title_documents" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Clients Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_clients"
                    style="@style/App.CardView"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="12dp"
                            android:src="@drawable/baseline_people_24"
                            android:backgroundTint="?attr/colorSecondaryContainer"
                            android:background="@drawable/profile_background"
                            app:shapeAppearanceOverlay="@style/App.ShapeAppearance.Circle"
                            app:tint="?attr/colorSecondary" />

                        <TextView
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/title_clients" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Dashboard Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_dashboard"
                    style="@style/App.CardView"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="12dp"
                            android:src="@drawable/baseline_dashboard_24"
                            android:backgroundTint="?attr/colorTertiaryContainer"
                            android:background="@drawable/profile_background"
                            app:shapeAppearanceOverlay="@style/App.ShapeAppearance.Circle"
                            app:tint="?attr/colorTertiary" />

                        <TextView
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/title_dashboard" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Company Profile Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_profile"
                    style="@style/App.CardView"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="12dp"
                            android:src="@drawable/baseline_business_24"
                            android:backgroundTint="?attr/colorSurfaceContainerHigh"
                            android:background="@drawable/profile_background"
                            app:shapeAppearanceOverlay="@style/App.ShapeAppearance.Circle"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            style="@style/App.TextAppearance.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/pref_title_profile"
                            android:textAlignment="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
