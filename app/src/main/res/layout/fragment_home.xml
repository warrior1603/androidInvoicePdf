<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Executive Greeting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_canvas_header"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_home_user_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:cardBackgroundColor="?attr/colorPrimary">
                    <TextView
                        android:id="@+id/txt_home_user_initials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_greeting"
                        style="@style/App.TextAppearance.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bonjour,"
                        android:textSize="24sp"
                        android:textColor="?attr/colorOnSurface" />
                    <TextView
                        android:id="@+id/txt_current_date"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:alpha="0.4"
                        android:letterSpacing="0.1"
                        android:text="VENDREDI 15 AOÛT"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/txt_briefing_line"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:letterSpacing="0.15"
                        android:text="RÉSUMÉ DU JOUR"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorPrimary"
                        android:fontFamily="sans-serif-black"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: Financial Pulse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_vertical_bar_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="36dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_typcn_chart_line"
                                app:tint="?attr/colorPrimary"
                                android:alpha="0.8" />
                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:letterSpacing="0.25"
                                android:textSize="12sp"
                                android:textColor="?attr/colorPrimary"
                                android:text="FLUX DE TRÉSORERIE" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_separator_fading" />

                    <TextView
                        android:id="@+id/txt_home_revenue"
                        style="@style/App.TextAppearance.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0.00 €"
                        android:textSize="44sp"
                        android:textColor="?attr/colorOnSurface"
                        android:letterSpacing="-0.04" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/App.TextAppearance.LabelSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.4"
                                    android:letterSpacing="0.1"
                                    android:text="ENTRÉES" />
                                <TextView
                                    android:id="@+id/txt_home_income"
                                    style="@style/App.TextAppearance.TitleMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 €"
                                    android:textSize="13sp"
                                    android:textColor="@color/status_paid" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="32dp"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/App.TextAppearance.LabelSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.4"
                                    android:letterSpacing="0.1"
                                    android:text="SORTIES" />
                                <TextView
                                    android:id="@+id/txt_home_expenses"
                                    style="@style/App.TextAppearance.TitleMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 €"
                                    android:textSize="13sp"
                                    android:textColor="@color/status_cancelled" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_expense_ratio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            app:trackThickness="1.5dp"
                            app:trackColor="?attr/colorOutline"
                            app:indicatorColor="@color/status_cancelled"
                            android:progress="30" />
                    </LinearLayout>

                    <!-- Right Column: Distribution Chart -->
                    <FrameLayout
                        android:id="@+id/container_chart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_gravity="center_vertical">

                        <!-- The "Soft Charter" Glow (Restored) -->
                        <View
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_soft"
                            android:backgroundTint="?attr/colorPrimary"
                            android:alpha="0.04" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chart_distribution"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Section 2.5: Metrics Row with Background Sparkline -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- The Discret Background Sparkline (Soft Chart) -->
                <ImageView
                    android:id="@+id/sparkline_image"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:alpha="0.08"
                    android:scaleType="fitXY"
                    android:src="@drawable/revenue_sparkline"
                    app:tint="?attr/colorPrimary" />

                <!-- Technical Connection Rail -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="48dp"
                    android:background="@drawable/bg_separator_fading"
                    android:alpha="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:baselineAligned="false">

                    <!-- Factures Node -->
                    <LinearLayout
                        android:id="@+id/stat_invoices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">
                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_terminal_dot"
                                android:backgroundTint="@color/icon_documents" />
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_typcn_document"
                                app:tint="@color/icon_documents"
                                android:alpha="0.3" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txt_home_invoice_count"
                            style="@style/App.TextAppearance.NumberBig"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textColor="@color/icon_documents" />

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.6"
                            android:letterSpacing="0.2"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-black"
                            android:text="FACTURES" />
                    </LinearLayout>

                    <!-- Bons Node -->
                    <LinearLayout
                        android:id="@+id/stat_orders"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">
                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_terminal_dot"
                                android:backgroundTint="@color/icon_dashboard" />
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_typcn_cart"
                                app:tint="@color/icon_dashboard"
                                android:alpha="0.3" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txt_home_bon_count"
                            style="@style/App.TextAppearance.NumberBig"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textColor="@color/icon_dashboard" />

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.6"
                            android:letterSpacing="0.2"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-black"
                            android:text="BONS" />
                    </LinearLayout>

                    <!-- Courses Node -->
                    <LinearLayout
                        android:id="@+id/stat_bookings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">
                            <View
                                android:layout_width="4dp"
                                android:layout_height="4dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_terminal_dot"
                                android:backgroundTint="@color/icon_agenda" />
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_typcn_agenda"
                                app:tint="@color/icon_agenda"
                                android:alpha="0.3" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txt_home_booking_count"
                            style="@style/App.TextAppearance.NumberBig"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="26sp"
                            android:textColor="@color/icon_agenda" />

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.6"
                            android:letterSpacing="0.2"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-black"
                            android:text="COURSES" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Section 3: Navigation Services -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_vertical_bar_green" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_typcn_th_large_outline"
                            app:tint="@color/status_paid"
                            android:alpha="0.8" />
                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="0.25"
                            android:textSize="12sp"
                            android:textColor="@color/status_paid"
                            android:text="SERVICES" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_separator_fading"
                        android:backgroundTint="@color/status_paid" />

                    <GridLayout
                        android:id="@+id/services_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:columnCount="3">

                        <!-- Documents -->
                        <LinearLayout
                            android:id="@+id/card_documents"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">
                            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <View android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_circle_soft" android:backgroundTint="@color/icon_documents" android:alpha="0.08" />
                                <ImageView android:id="@+id/img_service_docs" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:src="@drawable/ic_typcn_folder_open" app:tint="@color/icon_documents" />
                                <View android:id="@+id/badge_documents" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:background="@drawable/circle_red_badge" android:visibility="gone" />
                            </FrameLayout>
                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="DOCUMENTS"
                                android:alpha="0.8"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Clients -->
                        <LinearLayout
                            android:id="@+id/card_clients"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">
                            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <View android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_circle_soft" android:backgroundTint="@color/icon_clients" android:alpha="0.08" />
                                <ImageView android:id="@+id/img_service_clients" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:src="@drawable/ic_typcn_group_outline" app:tint="@color/icon_clients" />
                                <View android:id="@+id/badge_clients" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:background="@drawable/circle_red_badge" android:visibility="gone" />
                            </FrameLayout>
                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="CLIENTS"
                                android:alpha="0.8"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Agenda -->
                        <LinearLayout
                            android:id="@+id/card_agenda"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">
                            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <View android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_circle_soft" android:backgroundTint="@color/icon_agenda" android:alpha="0.08" />
                                <ImageView android:id="@+id/img_service_agenda" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:src="@drawable/ic_typcn_calendar_outline" app:tint="@color/icon_agenda" />
                                <View android:id="@+id/badge_agenda" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:background="@drawable/circle_red_badge" android:visibility="gone" />
                            </FrameLayout>
                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="AGENDA"
                                android:alpha="0.8"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Dashboard -->
                        <LinearLayout
                            android:id="@+id/card_dashboard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">
                            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <View android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_circle_soft" android:backgroundTint="@color/icon_dashboard" android:alpha="0.04" />
                                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:src="@drawable/ic_typcn_chart_pie_outline" app:tint="@color/icon_dashboard" />
                            </FrameLayout>
                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="STATS"
                                android:alpha="0.5"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Entreprise -->
                        <LinearLayout
                            android:id="@+id/card_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">
                            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <View android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_circle_soft" android:backgroundTint="@color/icon_profile" android:alpha="0.04" />
                                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center" android:src="@drawable/ic_typcn_entreprise" app:tint="@color/icon_profile" />
                            </FrameLayout>
                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="PROFIL"
                                android:alpha="0.5"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Settings -->
                        <LinearLayout
                            android:id="@+id/card_settings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="12dp">
                            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <View android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_circle_soft" android:backgroundTint="@color/icon_settings" android:alpha="0.04" />
                                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_typcn_spanner_outline" app:tint="@color/icon_settings" />
                            </FrameLayout>
                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="RÉGLAGES"
                                android:alpha="0.5"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Section 4: Upcoming Trip & Alerts -->
            <LinearLayout
                android:id="@+id/card_next_trip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_soft"
                android:backgroundTint="@color/icon_agenda_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/rounded_calendar_today_24" app:tint="@color/icon_agenda" />
                <TextView android:id="@+id/txt_next_trip_time" style="@style/App.TextAppearance.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="14:30" android:textColor="@color/icon_agenda" />
                <TextView android:id="@+id/txt_next_trip_route" style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:alpha="0.7" android:ellipsize="end" android:maxLines="1" android:text="Route" android:textColor="@color/icon_agenda" />
                <ImageView android:id="@+id/btn_view_trip" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="8dp" android:alpha="0.5" android:src="@drawable/ic_typcn_chevron_right" app:tint="@color/icon_agenda" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_overdue_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_soft"
                android:backgroundTint="@color/status_cancelled_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/rounded_info_24" app:tint="@color/status_cancelled" />
                <TextView android:id="@+id/txt_overdue_count" style="@style/App.TextAppearance.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/label_overdue_alert" android:textColor="@color/status_cancelled" android:textSize="11sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="6dp" android:alpha="0.5" android:src="@drawable/ic_typcn_chevron_right" app:tint="@color/status_cancelled" />
            </LinearLayout>

            <!-- Section 5: Activity -->
                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="40dp"
                android:paddingBottom="48dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_vertical_bar_history" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_typcn_time"
                                app:tint="@color/icon_agenda"
                                android:alpha="0.8" />
                            <TextView
                                style="@style/App.TextAppearance.LabelSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:letterSpacing="0.25"
                                android:textSize="12sp"
                                android:textColor="@color/icon_agenda"
                                android:text="ACTIVITÉ RÉCENTE" />
                        </LinearLayout>
                        <TextView android:id="@+id/btn_view_all_recent" style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VOIR TOUT" android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_separator_fading"
                        android:backgroundTint="@color/icon_agenda" />
                    <com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/shimmer_view_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:shimmer_auto_start="true">
                        <include layout="@layout/shimmer_home_recent" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_home_recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" android:layoutAnimation="@anim/layout_animation_fall_down" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>