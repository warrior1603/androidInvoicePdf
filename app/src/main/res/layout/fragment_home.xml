<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Executive Greeting -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="32dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_home_user_avatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorPrimary">
                    <TextView
                        android:id="@+id/txt_home_user_initials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txt_greeting"
                        style="@style/App.TextAppearance.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_welcome_back"
                        android:textSize="32sp"
                        android:letterSpacing="-0.02" />
                    <TextView
                        android:id="@+id/txt_current_date"
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.3"
                        android:text="14 AOÛT" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 2: Financial Pulse -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_vertical_bar_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="32dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:orientation="vertical">

                        <TextView
                            style="@style/App.TextAppearance.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.4"
                            android:letterSpacing="0.3"
                            android:text="BILAN FINANCIER" />

                        <TextView
                            android:id="@+id/txt_home_revenue"
                            style="@style/App.TextAppearance.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0.00 €"
                            android:textSize="40sp"
                            android:letterSpacing="-0.03" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/App.TextAppearance.LabelSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.3"
                                    android:letterSpacing="0.1"
                                    android:text="ENTRÉES" />
                                <TextView
                                    android:id="@+id/txt_home_income"
                                    style="@style/App.TextAppearance.TitleMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 €"
                                    android:textSize="14sp"
                                    android:textColor="@color/status_paid" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:orientation="vertical">
                                <TextView
                                    style="@style/App.TextAppearance.LabelSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.3"
                                    android:letterSpacing="0.1"
                                    android:text="SORTIES" />
                                <TextView
                                    android:id="@+id/txt_home_expenses"
                                    style="@style/App.TextAppearance.TitleMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 €"
                                    android:textSize="14sp"
                                    android:textColor="@color/status_cancelled" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_expense_ratio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            app:trackThickness="1dp"
                            app:trackColor="?attr/colorOutlineVariant"
                            app:indicatorColor="@color/status_cancelled"
                            android:progress="30" />
                    </LinearLayout>

                    <!-- Right Column: Soft Glow Distribution Chart -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center_vertical">

                        <!-- The "Soft Charter" Glow -->
                        <View
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_soft"
                            android:backgroundTint="?attr/colorPrimary"
                            android:alpha="0.04" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/chart_distribution"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Section 2.5: Metrics Row with Background Sparkline -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- The Discret Background Sparkline (Soft Chart) -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:alpha="0.04"
                    android:scaleType="fitXY"
                    android:src="@drawable/revenue_sparkline"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="28dp"
                    android:gravity="center">

                    <!-- Stat Factures -->
                    <LinearLayout
                        android:id="@+id/stat_invoices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_solid_circle" android:backgroundTint="@color/icon_documents" android:alpha="0.8" />
                        <TextView android:id="@+id/txt_home_invoice_count" style="@style/App.TextAppearance.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="0" android:textSize="20sp" />
                        <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:alpha="0.3" android:text="FACTURES" android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Stat Bons -->
                    <LinearLayout
                        android:id="@+id/stat_orders"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_solid_circle" android:backgroundTint="@color/icon_dashboard" android:alpha="0.8" />
                        <TextView android:id="@+id/txt_home_bon_count" style="@style/App.TextAppearance.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="0" android:textSize="20sp" />
                        <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:alpha="0.3" android:text="BONS" android:textSize="8sp" />
                    </LinearLayout>

                    <!-- Stat Courses -->
                    <LinearLayout
                        android:id="@+id/stat_bookings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_solid_circle" android:backgroundTint="@color/icon_agenda" android:alpha="0.8" />
                        <TextView android:id="@+id/txt_home_booking_count" style="@style/App.TextAppearance.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="0" android:textSize="20sp" />
                        <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:alpha="0.3" android:text="COURSES" android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:alpha="0.08" />

            <!-- Section 3: Navigation Services -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_vertical_bar_green" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="20dp">

                    <TextView
                        style="@style/App.TextAppearance.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.3"
                        android:letterSpacing="0.3"
                        android:text="SERVICES" />

                    <GridLayout
                        android:id="@+id/services_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:columnCount="3">

                        <!-- Documents -->
                        <LinearLayout
                            android:id="@+id/card_documents"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="20dp">
                            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                                <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_typcn_document" app:tint="@color/icon_documents" />
                                <View android:id="@+id/badge_overdue" android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="top|end" android:layout_marginTop="-2dp" android:layout_marginEnd="-2dp" android:background="@drawable/circle_red_badge" android:visibility="gone" />
                            </FrameLayout>
                            <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="DOCUMENTS" android:alpha="0.25" android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Clients -->
                        <LinearLayout
                            android:id="@+id/card_clients"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="20dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_typcn_group_outline" app:tint="@color/icon_clients" />
                            <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="CLIENTS" android:alpha="0.25" android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Agenda -->
                        <LinearLayout
                            android:id="@+id/card_agenda"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="20dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_typcn_calendar_outline" app:tint="@color/icon_agenda" />
                            <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="AGENDA" android:alpha="0.25" android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Dashboard -->
                        <LinearLayout
                            android:id="@+id/card_dashboard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="20dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_typcn_chart_pie_outline" app:tint="@color/icon_dashboard" />
                            <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="STATS" android:alpha="0.25" android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Entreprise -->
                        <LinearLayout
                            android:id="@+id/card_profile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="20dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_typcn_entreprise" app:tint="@color/icon_profile" />
                            <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="PROFIL" android:alpha="0.25" android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Settings -->
                        <LinearLayout
                            android:id="@+id/card_settings"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="20dp">
                            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:src="@drawable/ic_typcn_spanner_outline" app:tint="@color/icon_settings" />
                            <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="REGLAGES" android:alpha="0.25" android:textSize="9sp" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Section 4: Upcoming Trip & Alerts -->
            <LinearLayout
                android:id="@+id/card_next_trip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_soft"
                android:backgroundTint="@color/icon_agenda_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/rounded_calendar_today_24" app:tint="@color/icon_agenda" />
                <TextView android:id="@+id/txt_next_trip_time" style="@style/App.TextAppearance.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="14:30" android:textColor="@color/icon_agenda" />
                <TextView android:id="@+id/txt_next_trip_route" style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:alpha="0.7" android:ellipsize="end" android:maxLines="1" android:text="Route" android:textColor="@color/icon_agenda" />
                <ImageView android:id="@+id/btn_view_trip" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="8dp" android:alpha="0.5" android:src="@drawable/ic_typcn_chevron_right" app:tint="@color/icon_agenda" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_overdue_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_soft"
                android:backgroundTint="@color/status_cancelled_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/rounded_info_24" app:tint="@color/status_cancelled" />
                <TextView android:id="@+id/txt_overdue_count" style="@style/App.TextAppearance.LabelLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/label_overdue_alert" android:textColor="@color/status_cancelled" android:textSize="11sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="6dp" android:alpha="0.5" android:src="@drawable/ic_typcn_chevron_right" app:tint="@color/status_cancelled" />
            </LinearLayout>

            <!-- Section 5: Activity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="40dp"
                android:paddingBottom="48dp">
                <View android:layout_width="6dp" android:layout_height="match_parent" android:layout_marginVertical="12dp" android:background="@drawable/bg_vertical_bar_history" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView style="@style/App.TextAppearance.LabelSmall" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:alpha="0.3" android:letterSpacing="0.3" android:text="ACTIVITÉ RÉCENTE" />
                        <TextView android:id="@+id/btn_view_all_recent" style="@style/App.TextAppearance.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VOIR TOUT" android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                    <com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/shimmer_view_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:shimmer_auto_start="true">
                        <include layout="@layout/shimmer_home_recent" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_home_recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" android:layoutAnimation="@anim/layout_animation_fall_down" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>