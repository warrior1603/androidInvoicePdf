<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
tools:context=".fragments.PersonalSettingsFragment">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".fragments.PersonalSettingsFragment"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xxl">

            <TextView
                android:id="@+id/textView4"
                style="@style/App.FormSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="Informations entreprise" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/App.CardView"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/card_inner_padding"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/user_id_svgrepo_com"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="Nom"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_street_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/direction_road_sign_icon"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="Rue"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/mailed_mail_svgrepo_com"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="Code Postale"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_code_postale"
                    />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/city_svgrepo_com"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="Ville"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_city"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/earth_svgrepo_com"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="Pays"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_country"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_siren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/baseline_siren"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="N° Siren"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_tva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/tax_icon"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="N° TVA"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_tel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/baseline_local_phone_24"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="N° Tel"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/attherate_icon"
                app:endIconMode="clear_text"
                app:helperText="exemple@domaine.com"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="Email"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/edit_email"
                    android:inputType="textEmailAddress"
                    />
            </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textView3"
                style="@style/App.FormSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:layout_marginTop="@dimen/form_section_spacing"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="Informations chauffeur" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/App.CardView"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/card_inner_padding"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_chauffeur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/driver"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="Chauffeur"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_plaque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/plaque"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="Plaque"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/edit_Evtc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:startIconDrawable="@drawable/evtc"
                app:endIconMode="clear_text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="N° EVTC"
                style="@style/App.TextInput">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textViewBank"
                style="@style/App.FormSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:layout_marginTop="@dimen/form_section_spacing"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="Coordonnées bancaires" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardViewBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/App.CardView"
                android:layout_marginHorizontal="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                app:cardPreventCornerOverlap="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_inner_padding"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/edit_iban"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@drawable/hand_money_icon"
                        app:endIconMode="clear_text"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:hint="IBAN"
                        style="@style/App.TextInput">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/edit_bic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@drawable/bank_euro_specifications_svgrepo_com"
                        app:endIconMode="clear_text"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:hint="BIC"
                        style="@style/App.TextInput">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/edit_bank_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@drawable/location_pin_icon"
                        app:endIconMode="clear_text"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:hint="Adresse du titulaire"
                        style="@style/App.TextInput">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BUTTONS -->
            <Button
                android:id="@+id/btn_save_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xxl"
                app:icon="@drawable/save_as_icon"
                app:iconGravity="textStart"
                android:text="  Enregister les details"
                style="@style/App.Button"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>