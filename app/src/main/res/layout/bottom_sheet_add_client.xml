<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="?attr/colorSurface">

    <!-- Executive Vertical Accent (Green for Client) -->
    <View
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_vertical_bar_green" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.3"
                android:letterSpacing="0.3"
                android:text="STUDIO DE RÉFÉRENCEMENT" />

            <TextView
                android:id="@+id/txt_title"
                style="@style/App.TextAppearance.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nouveau Client"
                android:textSize="28sp"
                android:letterSpacing="-0.02" />

            <!-- Stepper Indicators (Minimal Bars) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:paddingHorizontal="40dp">
                <View
                    android:id="@+id/step_indicator_1"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vertical_bar_green" />
                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />
                <View
                    android:id="@+id/step_indicator_2"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.3" />
            </LinearLayout>
        </LinearLayout>

        <ViewFlipper
            android:id="@+id/view_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="300dp">

            <!-- Step 1: Identity & Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_name" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_street" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_zip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <include layout="@layout/view_settings_input_item" android:id="@+id/item_city" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" />
                </LinearLayout>
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_country" />
            </LinearLayout>

            <!-- Step 2: Contact & Legal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_siren" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_tva" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_phone" />
                <include layout="@layout/view_settings_input_item" android:id="@+id/item_email" />
            </LinearLayout>
        </ViewFlipper>

        <!-- Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_client"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Retour"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next_client"
                style="@style/App.Button"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="Suivant"
                app:backgroundTint="@color/status_paid" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/App.Button"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:text="Enregistrer"
                android:visibility="gone"
                app:backgroundTint="@color/status_paid" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
