<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="18dp"
        android:paddingHorizontal="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatarContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#0D000000">

            <TextView
                android:id="@+id/textViewInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="JD"
                android:textColor="@android:color/white"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewItem"
                style="@style/App.TextAppearance.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Client Name"
                android:textSize="16sp"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/textViewCity"
                style="@style/App.TextAppearance.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="CITY"
                android:alpha="0.4"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.06"
                android:background="@drawable/bg_circle_soft"
                android:backgroundTint="?attr/colorPrimary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCall"
                style="?attr/materialIconButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:icon="@drawable/rounded_local_phone_24"
                app:iconTint="?attr/colorPrimary"
                android:alpha="0.9" />
        </FrameLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_typcn_chevron_right"
            app:tint="?attr/colorOutline"
            android:alpha="0.3"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="84dp"
        android:background="?attr/colorOutline"
        android:alpha="0.06" />

</FrameLayout>
